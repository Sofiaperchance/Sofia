      // deleting one of several selected rows means deleting the selection
      if (multiSel[path] && multiCount() > 1) { deleteMulti(); return; }
      var targets = isFolder ? filesUnderFolder(path) : [path];
      if (isFolder && !targets.length) { // empty (UI-only) folder — nothing pending to lose
        remapEmptyFolders(path, null);
        preserveParentFolderOf(path);
        clearSelectionUnder([{ path: path, isFolder: true }], []);
        render();
        return;
      }
      var content = document.createElement("div");
      var line = document.createElement("div");
      line.appendChild(document.createTextNode("Delete " + (isFolder ? targets.length + (targets.length === 1 ? " file" : " files") + " under " : "")));
      line.appendChild(pathChipEl(path, isFolder));
      line.appendChild(document.createTextNode("?"));
      content.appendChild(line);
      content.appendChild(deleteNotesUl());
      mConfirm(content).then(function (yes) {
        if (!yes) return;
        var chain = Promise.resolve();
        targets.forEach(function (p) { chain = chain.then(function () { return FS().deleteFile(p); }); });
        chain.then(function () {
          if (isFolder) remapEmptyFolders(path, null);
          preserveParentFolderOf(path);
          clearSelectionUnder([{ path: path, isFolder: isFolder }], targets);
          render();
        }).catch(function (e) { mAlert(String(e.message || e)); render(); });
      });
    }

    // internal drag-move of one or more rows (files/folders) into a folder ("" = root).
    // Collisions or into-itself moves abort the whole thing — a multi-drag must never leave
    // the selection half-moved.
    function moveEntriesInto(entries, folderPath) {
      var draggedFolders = entries.filter(function (en) { return en.isFolder; }).map(function (en) { return en.path; });
      function coveredByDraggedFolder(p) { // it moves with its dragged parent folder
        return draggedFolders.some(function (fp) { return p !== fp && p.indexOf(fp + "/") === 0; });
      }
      var moves = [];       // concrete file renames [from, to]
      var entryMoves = [];  // top-level entry remaps [from, to, isFolder] (selection/folds/emptyFolders)
      var conflicts = [];
      var destTaken = {};
      entries.forEach(function (en) {
        if (!en.path || coveredByDraggedFolder(en.path)) return;
        if (en.isFolder ? !anyUnder(en.path) : !FS().list()[en.path]) return;
        var dest = folderPath ? folderPath + "/" + en.path.split("/").pop() : en.path.split("/").pop();
        if (dest === en.path) return;
        if (en.isFolder && (folderPath === en.path || folderPath.indexOf(en.path + "/") === 0)) {
          conflicts.push('"' + en.path + '" can\'t move into itself');
          return;
        }
        if (FS().list()[dest] || anyUnder(dest) || destTaken[dest]) { conflicts.push('"' + dest + '" already exists'); return; }
        destTaken[dest] = true;
        entryMoves.push([en.path, dest, en.isFolder]);
        if (en.isFolder) filesUnderFolder(en.path).forEach(function (p) { moves.push([p, dest + p.slice(en.path.length)]); });
        else moves.push([en.path, dest]);
      });
      if (conflicts.length) { mAlert(conflicts.join("\n") + "\n\nnothing was moved"); return; }
      if (!entryMoves.length) return;
      var chain = Promise.resolve();
      moves.forEach(function (m) { chain = chain.then(function () { return FS().renameFile(m[0], m[1]); }); });
      chain.then(function () {
        entryMoves.forEach(function (m) {
          if (m[2]) { // folder bookkeeping, mirroring commitRename's folder branch
            remapEmptyFolders(m[0], m[1]);
            if (collapsedM()[m[0]] != null) { collapsedM()[m[1]] = collapsedM()[m[0]]; delete collapsedM()[m[0]]; }
          }
          preserveParentFolderOf(m[0]); // moving a folder's last child out keeps the source folder
          if (multiSel[m[0]]) { var kind = multiSel[m[0]]; delete multiSel[m[0]]; multiSel[m[1]] = kind; }
          if (selAnchor === m[0]) selAnchor = m[1];
          if (selectedPath === m[0]) { selectedPath = m[1]; renderViewer(); }
          else if (selectedPath && m[2] && selectedPath.indexOf(m[0] + "/") === 0) { selectedPath = m[1] + selectedPath.slice(m[0].length); renderViewer(); }
        });
        render();
      }).catch(function (err) { mAlert(String(err.message || err)); render(); });
    }

    // drag & drop: internal moves + OS file/folder drops.
    // NB: only call this ONCE per element — rows are recreated every render (fine), but the
    // tree container persists; wiring it inside render() used to stack duplicate drop handlers
    // (symptom: each drop error alerted 2x, 4x, 8x…).
    function wireDropTarget(el, folderPathFn) {
      el.addEventListener("dragover", function (e) { e.preventDefault(); e.stopPropagation(); el.style.outline = "1px dashed rgba(128,128,128,.8)"; });
      el.addEventListener("dragleave", function () { el.style.outline = ""; });
      el.addEventListener("drop", function (e) {
        e.preventDefault(); e.stopPropagation();
        el.style.outline = "";
        var folderPath = typeof folderPathFn === "function" ? folderPathFn() : folderPathFn;
        var internal = e.dataTransfer.getData("application/x-perchance-src-path"); // legacy single-file payload
        var internalMulti = e.dataTransfer.getData("application/x-perchance-src-paths");
        if (internal || internalMulti) {
          var entries = internal ? [{ path: internal, isFolder: false }] : [];
          if (internalMulti) {
            try { entries = (JSON.parse(internalMulti) || []).filter(function (en) { return en && typeof en.path === "string"; }); }
            catch (err) { entries = []; }
          }
          moveEntriesInto(entries, folderPath);
          return;
        }
        var release = beginPanelIntake();
        if (!release) return;
        runPanelIntake(collectDroppedFiles(e.dataTransfer), release, folderPath);
      });
    }

    wireDropTarget(refs.tree, ""); // once — see the note on wireDropTarget

    function wireRowContextMenu(row, path, isFolder) {
      row.addEventListener("contextmenu", function (e) {
        e.preventDefault();
        e.stopPropagation();
        openMenuAt(e.clientX, e.clientY, nodeMenuItems(path, isFolder));
      });
    }

    // fold-state persistence: light IndexedDB record (same db, "folds|<generator>" key in the
    // meta store) so collapse/expand choices survive reloads. Best-effort only.
    var foldSaveTimer = null, lastFoldsJson = "";
    function persistFolds() {
      var rec = { src: perMode.src.collapsed, scratch: perMode.scratch.collapsed };
      var j = JSON.stringify(rec);
      if (j === lastFoldsJson) return;
      lastFoldsJson = j;
      idb("meta", "readwrite", function (store) { store.put(rec, "folds|" + srcState.generatorName()); }).catch(function () {});
    }

    function render() {
      multiPaths().forEach(function (p) { // deleted/renamed underneath us
        if (multiSel[p] === "folder" ? !anyUnder(p) : !FS().list()[p]) delete multiSel[p];
      });
      visibleRows = [];
      refreshUsage();
      clearTimeout(foldSaveTimer);
      foldSaveTimer = setTimeout(persistFolds, 300); // every mutation path ends in render()
      var model = buildTreeModel();
      refs.tree.textContent = "";

      function creatingRow(depth) {
        var row = document.createElement("div");
        row.style.cssText = rowBase(depth);
        var icon = document.createElement("span");
        icon.textContent = creating.isFolder ? "📁" : "📄";
        row.appendChild(icon);
        var parent = creating.parent, isFolder = creating.isFolder;
        row.appendChild(makeInlineInput(creating.draft || "", function (name) { commitCreate(parent, isFolder, name); }, createValidator(parent, isFolder)));
        return row;
      }

      var searching = searchActive(); // matched files must all be visible: folds are ignored
      function renderFolder(node, depth, folderPath) {
        Object.keys(node.folders).sort().forEach(function (name) {
          var folder = node.folders[name];
          visibleRows.push({ path: folder.path, isFolder: true });
          var folderOpen = searching || !isCollapsed(folder.path);
          var fHighlighted = multiCount() ? !!multiSel[folder.path] : (folder.path === selectedPath && selectedIsFolder);
          var row = document.createElement("div");
          row.className = "psrcTreeRow";
          row.style.cssText = rowBase(depth) + "opacity:.9;" + (fHighlighted ? "background:rgba(90,130,255,.25);" : "");
          var caret = folderOpen ? "▾" : "▸";
          if (renaming && renaming.isFolder && renaming.path === folder.path) {
            var ricon = document.createElement("span");
            ricon.textContent = caret + " 📁";
            row.appendChild(ricon);
            row.appendChild(makeInlineInput(name, function (n) { commitRename(folder.path, true, n); }, renameValidator(folder.path, true)));
            refs.tree.appendChild(row);
            if (folderOpen) renderFolder(folder, depth + 1, folder.path);
            return;
          }
          var label = document.createElement("span");
          label.textContent = caret + " 📁 " + name;
          label.style.cssText = "overflow:hidden; text-overflow:ellipsis;";
          row.appendChild(label);
          var fbtn = makeMenuButton(folder.path, true);
          fbtn.style.marginLeft = "auto";
          row.appendChild(fbtn);
          row.onclick = function (ev) {
            if (ev.ctrlKey || ev.metaKey) { ctrlToggle(folder.path, true); return; } // never folds
            if (ev.shiftKey) { shiftSelectTo(folder.path); return; }                 // never folds
            clearMultiSel();
            selAnchor = folder.path;
            flushPendingEdit();
            selectedPath = folder.path;
            selectedIsFolder = true;
            pathEditing = false;
            // plain click both selects AND toggles the fold (fold state is meaningless while a
            // search filter is showing everything)
            if (!searching) collapsedM()[folder.path] = !isCollapsed(folder.path);
            render();
            renderViewer();
          };
          row.draggable = true;
          row.addEventListener("dragstart", function (e) {
            e.dataTransfer.setData("application/x-perchance-src-paths", JSON.stringify(dragEntriesFor(folder.path, true)));
          });
          wireDropTarget(row, folder.path);
          wireRowContextMenu(row, folder.path, true);
          refs.tree.appendChild(row);
          if (folderOpen) renderFolder(folder, depth + 1, folder.path);
        });
        node.files.forEach(function (f) {
          visibleRows.push({ path: f.path, isFolder: false });
          var highlighted = multiCount() ? !!multiSel[f.path] : (f.path === selectedPath && !selectedIsFolder);
          var row = document.createElement("div");
          row.className = "psrcTreeRow";
          row.style.cssText = rowBase(depth) + (highlighted ? "background:rgba(90,130,255,.25);" : "");
          if (renaming && !renaming.isFolder && renaming.path === f.path) {
            var ricon = document.createElement("span");
            ricon.textContent = "📄";
            row.appendChild(ricon);
            row.appendChild(makeInlineInput(f.name, function (n) { commitRename(f.path, false, n); }, renameValidator(f.path, false)));
            refs.tree.appendChild(row);
            return;
          }
          row.draggable = true;
          row.addEventListener("dragstart", function (e) {
            e.dataTransfer.setData("application/x-perchance-src-paths", JSON.stringify(dragEntriesFor(f.path, false)));
          });
          var label = document.createElement("span");
          label.textContent = "📄 " + f.name;
          label.style.cssText = "overflow:hidden; text-overflow:ellipsis;";
          var size = document.createElement("span");
          size.textContent = (f.unsaved ? "● " : "") + fmtSize(f.size);
          size.title = f.unsaved ? "not part of the saved generator yet" : (isSrc() ? "saved" : "");
          size.style.cssText = "opacity:.5; font-size:11px; margin-left:auto; flex-shrink:0;"; // auto margin -> sits right, against the ⋯
          row.appendChild(label);
          row.appendChild(size);
          row.appendChild(makeMenuButton(f.path, false));
          row.onclick = function (ev) {
            if (ev.ctrlKey || ev.metaKey) { ctrlToggle(f.path, false); return; }
            if (ev.shiftKey) { shiftSelectTo(f.path); return; }
            clearMultiSel();
            selAnchor = f.path;
            flushPendingEdit(); // commit any half-typed edit on the previous file first
            selectedPath = f.path;
            selectedIsFolder = false;
            pathEditing = false;
            render();
            renderViewer();
          };
          row.addEventListener("dblclick", function (ev) { if (!ev.ctrlKey && !ev.metaKey && !ev.shiftKey) startRename(f.path, false); }); // editor nicety
          wireRowContextMenu(row, f.path, false);
          refs.tree.appendChild(row);
        });
        if (creating && creating.parent === folderPath) refs.tree.appendChild(creatingRow(depth));
      }
      renderFolder(model, 0, "");

      if (searching) {
        if (!Object.keys(search.results || {}).length) {
          var hint = document.createElement("div");
          hint.style.cssText = "padding:14px 10px; opacity:.6;";
          hint.textContent = !search.query
            ? "type to search" + (search.scope !== null ? " in '" + (search.scope.split("/").pop() || search.scope) + "'" : "") + "…"
            : (search.running ? "searching…" : "no matches");
          refs.tree.appendChild(hint);
        }
      } else if (!Object.keys(FS().list()).length && !creating && !Object.keys(emptyFoldersM()).length) {
        var empty = document.createElement("div");
        empty.style.cssText = "padding:14px 10px; opacity:.6;";
        var reason = !isSrc() && scratchFs.unavailableReason && scratchFs.unavailableReason();
        empty.textContent = reason
          ? reason
          : (isSrc()
            ? "No src files yet. The AI helper can create them (src/…), drop files/folders here, or right-click to create one."
            : "Scratch is empty — it's the AI helper's private temporary working area for this session.");
        refs.tree.appendChild(empty);
      }
    }

    // ------------------------------------------------------------ viewer + path bar
    // The path bar never wraps; ✏️ (or double-clicking the path) turns it into a go-to/create
    // input (Enter or ✔️ commits, Esc cancels). With no file selected the bar IS the input —
    // type a path, tap ✔️.
    function commitPathInput(raw) {
      var v = String(raw || "").trim().replace(/^\/+/, "");
      var prefix = isSrc() ? "src/" : "scratch/";
      if (v.indexOf(prefix) === 0) v = v.slice(prefix.length);
      v = v.replace(/\/+$/, "");
      if (!v) return;
      if (FS().list()[v]) { // existing file -> open it
        selectedPath = v;
        selectedIsFolder = false;
        pathEditing = false;
        render();
        renderViewer();
        return;
      }
      if (anyUnder(v)) { // existing folder -> select it and expand down to it
        var parts = v.split("/");
        for (var i = 1; i <= parts.length; i++) collapsedM()[parts.slice(0, i).join("/")] = false;
        selectedPath = v;
        selectedIsFolder = true;
        pathEditing = false;
        render();
        renderViewer();
        return;
      }
      FS().writeFile(v, new ArrayBuffer(0)).then(function () { // new path -> create empty file
        selectedPath = v;
        selectedIsFolder = false;
        pathEditing = false;
        render();
        renderViewer();
      }).catch(function (e) { handleWriteError(e); });
    }
    function buildPathBar() {
      var prefix = isSrc() ? "src/" : "scratch/";
      var bar = document.createElement("div");
      bar.style.cssText = "display:flex; align-items:center; gap:4px; padding:3px 6px; border-bottom:1px solid rgba(128,128,128,.25); font-family:monospace; font-size:12px; flex-shrink:0;";
      var editing = pathEditing || !selectedPath;
      var actionBtn = document.createElement("button");
      actionBtn.style.cssText = "background:none; border:none; color:inherit; cursor:pointer; font-size:12px; padding:0 4px; opacity:.7; flex-shrink:0;";
      if (editing) {
        var input = document.createElement("input");
        input.type = "text";
        input.spellcheck = false;
        input.placeholder = prefix + "path/to/file";
        input.value = selectedPath ? prefix + selectedPath : "";
        input.style.cssText = "flex:1; min-width:0; background:rgba(0,0,0,.3); color:inherit; border:1px solid rgba(128,128,128,.4); border-radius:3px; font:inherit; padding:0 4px; outline:none;";
        actionBtn.textContent = "✔️";
        actionBtn.title = "go to this path (opens the file, or creates it if new)";
        var checkPath = function () {
          var v = input.value.trim().replace(/^\/+/, "");
          if (v.indexOf(prefix) === 0) v = v.slice(prefix.length);
          v = v.replace(/\/+$/, "");
          var err = null;
          if (v && !FS().list()[v] && !anyUnder(v)) err = validateFor(v); // would create — must be valid
          input.style.borderColor = err ? "#e05555" : "rgba(128,128,128,.4)";
          input.title = err || "";
          actionBtn.style.display = v && !err ? "" : "none";
          return err;
        };
        checkPath();
        input.addEventListener("input", checkPath);
        input.addEventListener("keydown", function (e) {
          e.stopPropagation();
          if (e.key === "Enter") { e.preventDefault(); if (!checkPath()) commitPathInput(input.value); }
          else if (e.key === "Escape") {
            e.preventDefault();
            if (selectedPath) { pathEditing = false; renderViewer(); }
            else input.blur();
          }
        });
        actionBtn.onclick = function () { if (!checkPath()) commitPathInput(input.value); };
        bar.appendChild(input);
        bar.appendChild(actionBtn);
        if (pathEditing) setTimeout(function () { input.focus(); input.setSelectionRange(input.value.length, input.value.length); }, 0);
      } else {
        var pathWrap = document.createElement("span");
        pathWrap.style.cssText = "flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;";
        // mute the directory part (final slash included) so the file NAME stands out
        var dirSpan = document.createElement("span");
        dirSpan.style.opacity = ".45";
        dirSpan.textContent = prefix + (selectedPath.indexOf("/") !== -1 ? selectedPath.slice(0, selectedPath.lastIndexOf("/") + 1) : "");
        var nameSpan = document.createElement("span");
        nameSpan.style.opacity = ".95";
        nameSpan.textContent = selectedPath.split("/").pop() + (selectedIsFolder ? "/" : "");
        pathWrap.appendChild(dirSpan);
        pathWrap.appendChild(nameSpan);
        pathWrap.title = prefix + selectedPath;
        var startEdit = function () { pathEditing = true; renderViewer(); };
        pathWrap.addEventListener("dblclick", startEdit);
        actionBtn.textContent = "✏️";
        actionBtn.title = "edit the path (go to / create a file)";
        actionBtn.onclick = startEdit;
        bar.appendChild(pathWrap);
        bar.appendChild(actionBtn);
      }
      return bar;
    }

    function renderViewer() {
      flushPendingEdit();
      pendingEditFlush = null;
      refs.viewer.textContent = "";
      refs.viewer.appendChild(buildPathBar());
      if (!selectedPath) {
        var hint = document.createElement("div");
        hint.style.cssText = "margin:auto; opacity:.5; padding:20px;";
        hint.textContent = "select a file";
        refs.viewer.appendChild(hint);
        return;
      }
      if (selectedIsFolder) { // a folder gets the highlight and path bar but no preview
        viewerRev = null;
        var ffiles = filesUnderFolder(selectedPath);
        var fbytes = 0;
        ffiles.forEach(function (p) { fbytes += (FS().list()[p] || {}).size || 0; });
        var fhint = document.createElement("div");
        fhint.style.cssText = "margin:auto; opacity:.5; padding:20px; text-align:center;";
        fhint.textContent = "📁 " + (ffiles.length ? ffiles.length + (ffiles.length === 1 ? " file · " : " files · ") + fmtSize(fbytes) : "empty folder");
        refs.viewer.appendChild(fhint);
        return;
      }
      var path = selectedPath;
      viewerRev = (FS().list()[path] || {}).rev || null;
      var body = document.createElement("div");
      body.style.cssText = "flex:1; display:flex; min-height:0; position:relative;";
      refs.viewer.appendChild(body);
      if ((FS().list()[path] || {}).size > 32 * 1048576) {
        body.innerHTML = '<div style="margin:auto; opacity:.6; padding:20px; text-align:center;">Large file — preview skipped to keep the editor responsive.</div>';
        return;
      }
      body.innerHTML = '<div style="margin:auto; opacity:.5;">loading…</div>';
      FS().readFile(path).then(function (bytes) {
        if (selectedPath !== path) return;
        body.textContent = "";
        var ext = extOf(path);
        if (TEXT_VIEW_EXTS.test(ext) || (bytes.byteLength < 512 * 1024 && isLikelyTextBuf(bytes))) {
          var ta = document.createElement("textarea");
          ta.spellcheck = false;
          ta.wrap = "off";
          ta.placeholder = "empty file — type here";
          ta.style.cssText = "flex:1; background:transparent; color:inherit; border:none; outline:none; resize:none; font:12px/1.45 monospace; white-space:pre; padding:8px 10px;";
          try { ta.value = new TextDecoder("utf-8", { fatal: false }).decode(bytes); }
          catch (e) { ta.value = "[could not decode as text]"; ta.readOnly = true; }
          // "✅ saved" toast (bottom-right) so users know keystrokes are auto-kept
          var savedBadge = document.createElement("span");
          savedBadge.textContent = "✅ saved";
          savedBadge.style.cssText = "position:absolute; right:12px; bottom:8px; font-size:11px; opacity:0; transition:opacity .35s; pointer-events:none; background:rgba(20,22,26,.85); border-radius:4px; padding:1px 6px;";
          body.appendChild(savedBadge);
          var badgeTimer = null;
          function pulseSavedBadge() {
            savedBadge.style.opacity = ".85";
            clearTimeout(badgeTimer);
            badgeTimer = setTimeout(function () { savedBadge.style.opacity = "0"; }, 1400);
          }
          // editable: keystrokes land in the pending store (debounced), like any other editor
          // buffer — they only reach the server when the user saves the generator.
          var saveTimer = null, dirty = false;
          function flushEdit() {
            if (!dirty) return;
            dirty = false;
            clearTimeout(saveTimer);
            selfWriteUntil = Date.now() + 1500; // it's our own change — no viewer auto-refresh
            var buf = new TextEncoder().encode(ta.value).buffer;
            FS().writeFile(path, buf).then(function () {
              viewerRev = (FS().list()[path] || {}).rev || viewerRev;
              pulseSavedBadge();
            }).catch(function (e) {
              mAlert("couldn't apply the edit to " + path + ": " + (e && e.message || e));
            });
          }
          ta.addEventListener("input", function () {
            dirty = true;
            clearTimeout(saveTimer);
            saveTimer = setTimeout(flushEdit, 400);
          });
          ta.addEventListener("blur", flushEdit);
          ta.addEventListener("keydown", function (e) {
            if ((e.ctrlKey || e.metaKey) && String(e.key).toLowerCase() === "s") {
              e.preventDefault(); // no browser save-page dialog
              e.stopPropagation(); // no double-trigger via the editor's own handler
              flushEdit();
              try { if (window.app && window.app.saveGenerator) window.app.saveGenerator(); } catch (err) {}
            } else if (e.key === "Tab" && !e.ctrlKey && !e.metaKey && !e.altKey) {
              e.preventDefault(); // editor nicety: Tab indents instead of leaving the field
              ta.setRangeText("  ", ta.selectionStart, ta.selectionEnd, "end");
              dirty = true;
              clearTimeout(saveTimer);
              saveTimer = setTimeout(flushEdit, 400);
            }
          });
          pendingEditFlush = flushEdit;
          body.appendChild(ta);
        } else if (MEDIA_VIEW[ext]) {
          var url = URL.createObjectURL(new Blob([bytes], { type: UPLOAD_TYPE_HINTS[ext] || "application/octet-stream" }));
          var el;
          if (MEDIA_VIEW[ext] === "img") { el = document.createElement("img"); el.style.cssText = "max-width:100%; max-height:100%; margin:auto; object-fit:contain;"; }
          else { el = document.createElement(MEDIA_VIEW[ext]); el.controls = true; el.style.cssText = "margin:auto; max-width:100%;"; }
          el.src = url;
          el.onload = el.onloadeddata = function () { /* keep url alive while shown */ };
          body.appendChild(el);
        } else {
          body.innerHTML = '<div style="margin:auto; opacity:.6;">no preview — ' + fmtSize(bytes.byteLength) + "</div>";
        }
      }).catch(function (e) {
        if (selectedPath !== path) return;
        body.innerHTML = '<div style="margin:auto; color:#e08080; padding:16px; text-align:center;">' + String(e.message || e).replace(/</g, "&lt;") + "</div>";
      });
    }

    function isLikelyTextBuf(buf) {
      var view = new Uint8Array(buf.slice(0, 2048));
      for (var i = 0; i < view.length; i++) if (view[i] === 0) return false;
      return true;
    }

    function onActiveFsChange() {
      render();
      // the file on screen changed underneath us (usually the AI helper writing) — refresh the
      // viewer, unless the user's cursor is in it or the change was our own debounced edit
      if (!selectedPath) return;
      var entry = FS().list()[selectedPath];
      if (!entry || entry.rev === viewerRev) return;
      if (Date.now() < selfWriteUntil) { viewerRev = entry.rev; return; }
      var a = document.activeElement;
      if (a && refs.viewer.contains(a)) return;
      renderViewer();
    }
    srcState.onChange(function () { if (mode === "src") onActiveFsChange(); });
    if (scratchFs) scratchFs.onChange(function () { if (mode === "scratch") onActiveFsChange(); });
    render();
    renderViewer();
    // restore remembered fold state (async; re-render when it lands). Session-local toggles
    // made in the meantime win over the stored record.
    idbGet("meta", "folds|" + srcState.generatorName()).then(function (rec) {
      if (!rec) return;
      ["src", "scratch"].forEach(function (m) {
        if (!rec[m]) return;
        Object.keys(rec[m]).forEach(function (k) {
          if (perMode[m].collapsed[k] === undefined) perMode[m].collapsed[k] = !!rec[m][k];
        });
      });
      lastFoldsJson = ""; // force the next persist to re-baseline
      render();
    }).catch(function () {});
    return root;
  }

  window.PerchanceSrc = {
    createSrcState: createSrcState,
    downloadSnapshotZip: downloadSnapshotZip,
    buildFilesPanel: buildFilesPanel,
    collectDroppedFiles: collectDroppedFiles,
    threeWayMergeManifests: threeWayMergeManifests, // exported for the unit suite
    migrationMergeManifests: migrationMergeManifests,
    validatePath: validatePath,
    limits: { MAX_FILES: MAX_FILES, MAX_TOTAL_BYTES: MAX_TOTAL_BYTES, PER_FILE_LIMIT: PER_FILE_LIMIT }, // read-only, for tests/UI (keeps quota tests in step with raises)
    fmtSize: fmtSize,
    extOf: extOf,
    TEXT_VIEW_EXTS: TEXT_VIEW_EXTS,
    MEDIA_VIEW: MEDIA_VIEW,
    CDN_BASE: CDN_BASE,
    registerDraftCleanupHandler: function (fn) {
      if (typeof fn !== "function") throw new Error("draft cleanup handler must be a function");
      var previous = draftCleanupHandler;
      draftCleanupHandler = function (rec) { return Promise.all([previous(rec), fn(rec)]); };
      return Promise.all(Object.keys(cleanupGenerators).map(processDraftCleanupJournal));
    },
    processDraftCleanupJournal: processDraftCleanupJournal,
    limits: { MAX_FILES: MAX_FILES, MAX_TOTAL_BYTES: MAX_TOTAL_BYTES, PER_FILE_LIMIT: PER_FILE_LIMIT },
  };
})();
